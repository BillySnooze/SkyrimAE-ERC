{
  "modName": "EldenRingCombat",
  "displayName": "Elden Ring Combat",
  "minMcmVersion": 9,
  "cursorFillMode": "topToBottom",
  "pages": [
    {
      "pageDisplayName": "Combat",
      "cursorFillMode": "topToBottom",
      "content": [
        { "type": "header", "text": "Dodge" },
        {
          "id": "fRollStaminaCost:Combat",
          "type": "slider",
          "text": "Roll Stamina Cost",
          "help": "Stamina spent when a dodge roll starts. ELDEN RING default is 12.",
          "valueOptions": { "min": 0, "max": 50, "step": 1, "sourceType": "ModSettingFloat", "defaultValue": 12 }
        },
        {
          "id": "fIframeFraction:Combat",
          "type": "slider",
          "text": "I-Frame Fraction",
          "help": "Fraction of the roll that is invincible. 0.55 = first 55% of the roll.",
          "valueOptions": { "min": 0, "max": 1, "step": 0.05, "sourceType": "ModSettingFloat", "defaultValue": 0.55 }
        },
        {
          "id": "iDodgeKeyCode:Combat",
          "type": "slider",
          "text": "Dodge Key Code",
          "help": "DirectInput scan code for dodge. 56 = Left Alt (tap to roll, hold to sprint), 57 = Space, 42 = Left Shift.",
          "valueOptions": { "min": 1, "max": 255, "step": 1, "sourceType": "ModSettingInt", "defaultValue": 56 }
        },
        {
          "id": "fSprintHoldSeconds:Combat",
          "type": "slider",
          "text": "Sprint Hold Time",
          "help": "Holding dodge longer than this (seconds) is a sprint, not a roll.",
          "valueOptions": { "min": 0.05, "max": 0.6, "step": 0.01, "sourceType": "ModSettingFloat", "defaultValue": 0.25 }
        },
        {
          "id": "bEnableRolls:Combat",
          "type": "toggle",
          "text": "Enable Dodge Rolls",
          "help": "Turn the tap-to-roll system on or off.",
          "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": true }
        },
        {
          "id": "bEnableLockOnRolls:Combat",
          "type": "toggle",
          "text": "Enable Lock-On Rolls",
          "help": "Use directional roll variants while locked on, preserving facing.",
          "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": true }
        },
        { "type": "header", "text": "Impact" },
        {
          "id": "fHitStopSeconds:Combat",
          "type": "slider",
          "text": "Hit-Stop Duration",
          "help": "How long the world freezes on impact, in seconds.",
          "valueOptions": { "min": 0, "max": 0.3, "step": 0.01, "sourceType": "ModSettingFloat", "defaultValue": 0.06 }
        },
        {
          "id": "fHitStopScale:Combat",
          "type": "slider",
          "text": "Hit-Stop Timescale",
          "help": "Timescale multiplier during hit-stop. Lower = harder freeze.",
          "valueOptions": { "min": 0.05, "max": 1, "step": 0.05, "sourceType": "ModSettingFloat", "defaultValue": 0.15 }
        },
        {
          "id": "bEnableHitStop:Combat",
          "type": "toggle",
          "text": "Enable Hit-Stop",
          "help": "Freeze on impact, like ELDEN RING.",
          "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": true }
        },
        {
          "id": "bEnableGuardBreak:Combat",
          "type": "toggle",
          "text": "Enable Guard Break",
          "help": "Enable the four-tier hit reaction system.",
          "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": true }
        }
      ]
    },
    {
      "pageDisplayName": "Stagger",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "id": "fKnockdownHealthFraction:Stagger",
          "type": "slider",
          "text": "Knockdown Health Fraction",
          "help": "A power attack knocks you down only when health is below this fraction (0.35 = 35%).",
          "valueOptions": { "min": 0, "max": 1, "step": 0.05, "sourceType": "ModSettingFloat", "defaultValue": 0.35 }
        }
      ]
    },
    {
      "pageDisplayName": "Movement",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "id": "fRollDurationLight:Movement",
          "type": "slider",
          "text": "Light Roll Duration",
          "help": "Seconds the light-load roll takes (also sizes its i-frames).",
          "valueOptions": { "min": 0.2, "max": 2, "step": 0.01, "sourceType": "ModSettingFloat", "defaultValue": 0.62 }
        },
        {
          "id": "fRollDurationMedium:Movement",
          "type": "slider",
          "text": "Medium Roll Duration",
          "help": "Seconds the medium-load roll takes.",
          "valueOptions": { "min": 0.2, "max": 2, "step": 0.01, "sourceType": "ModSettingFloat", "defaultValue": 0.78 }
        },
        {
          "id": "fRollDurationHeavy:Movement",
          "type": "slider",
          "text": "Heavy Roll Duration",
          "help": "Seconds the heavy-load roll takes.",
          "valueOptions": { "min": 0.2, "max": 2, "step": 0.01, "sourceType": "ModSettingFloat", "defaultValue": 1.05 }
        },
        {
          "id": "fEquipLoadLightCut:Movement",
          "type": "slider",
          "text": "Light Load Cutoff",
          "help": "Carried/max weight below this ratio counts as light load (ER: 0.30).",
          "valueOptions": { "min": 0, "max": 1, "step": 0.05, "sourceType": "ModSettingFloat", "defaultValue": 0.3 }
        },
        {
          "id": "fEquipLoadMediumCut:Movement",
          "type": "slider",
          "text": "Medium Load Cutoff",
          "help": "Carried/max weight below this ratio counts as medium load (ER: 0.70).",
          "valueOptions": { "min": 0, "max": 1, "step": 0.05, "sourceType": "ModSettingFloat", "defaultValue": 0.7 }
        }
      ]
    },
    {
      "pageDisplayName": "Animations",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "id": "sAnimFlinch:Animations",
          "type": "input",
          "text": "Flinch Animation",
          "help": "Animation event name for the flinch reaction.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "HitReaction_Flinch" }
        },
        {
          "id": "sAnimStagger:Animations",
          "type": "input",
          "text": "Stagger Animation",
          "help": "Animation event name for the stagger reaction.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "HitReaction_Stagger" }
        },
        {
          "id": "sAnimLargeStagger:Animations",
          "type": "input",
          "text": "Large Stagger Animation",
          "help": "Animation event name for the large stagger.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "HitReaction_LargeStagger" }
        },
        {
          "id": "sAnimKnockdown:Animations",
          "type": "input",
          "text": "Knockdown Animation",
          "help": "Animation event name for the knockdown.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "HitReaction_Knockdown" }
        },
        {
          "id": "sRollLightFront:Animations",
          "type": "input",
          "text": "Light Roll Animation",
          "help": "Base animation event for the light roll (direction suffixes are appended).",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "ERC_Roll_Light_Front" }
        },
        {
          "id": "sRollMediumFront:Animations",
          "type": "input",
          "text": "Medium Roll Animation",
          "help": "Base animation event for the medium roll.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "ERC_Roll_Medium_Front" }
        },
        {
          "id": "sRollHeavyFront:Animations",
          "type": "input",
          "text": "Heavy Roll Animation",
          "help": "Base animation event for the heavy roll.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "ERC_Roll_Heavy_Front" }
        }
      ]
    }
  ]
}
