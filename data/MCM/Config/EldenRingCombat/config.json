{
  "modName": "EldenRingCombat",
  "displayName": "Elden Ring Combat",
  "minMcmVersion": 9,
  "cursorFillMode": "topToBottom",
  "pages": [
    {
      "pageDisplayName": "Combat",
      "cursorFillMode": "topToBottom",
      "content": [
        { "type": "header", "text": "Dodge" },
        {
          "id": "bDeferDodgeToTKDodge:Combat",
          "type": "toggle",
          "text": "Defer Dodge to TK Dodge RE",
          "help": "Recommended ON. TK Dodge RE performs the roll with its own animation, stamina cost and i-frames (via I-Frame Generator). Turning this OFF makes ERC roll instead, using the TK Dodge animation events listed on the Animations page, on ERC's own key. TK Dodge RE still answers to its own hotkey either way, so the two keys must differ (they do by default: ERC = V, TK Dodge = Left Alt).",
          "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": true }
        },
        {
          "id": "bEnableRolls:Combat",
          "type": "toggle",
          "text": "Enable ERC's Own Roll",
          "help": "Master switch for ERC's fallback roll. Ignored while Defer Dodge to TK Dodge RE is ON.",
          "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": true }
        },
        {
          "id": "iDodgeKeyCode:Combat",
          "type": "slider",
          "text": "ERC Dodge Key Code",
          "help": "Scan code ERC polls for its own roll (45 = X). Only used when Defer Dodge is OFF. Keep this clear of TK Dodge's key and of the V that JOJ's Timed Block-Dodge and Counter uses for its block key.",
          "valueOptions": { "min": 1, "max": 255, "step": 1, "formatString": "{0}", "sourceType": "ModSettingInt", "defaultValue": 45 }
        },
        {
          "id": "fRollStaminaCost:Combat",
          "type": "slider",
          "text": "Roll Stamina Cost (ERC roll only)",
          "help": "Only used when ERC runs its own roll, i.e. Defer Dodge is OFF. With TK Dodge RE the cost is DodgeStamina in Data\\SKSE\\Plugins\\TK Dodge RE.ini.",
          "valueOptions": { "min": 0, "max": 50, "step": 1, "formatString": "{0}", "sourceType": "ModSettingFloat", "defaultValue": 12 }
        },
        {
          "id": "fSprintHoldSeconds:Combat",
          "type": "slider",
          "text": "Sprint Hold Time",
          "help": "Holding the dodge key longer than this many seconds counts as a sprint, not a roll.",
          "valueOptions": { "min": 0.05, "max": 0.6, "step": 0.01, "formatString": "{2} s", "sourceType": "ModSettingFloat", "defaultValue": 0.25 }
        },
        {
          "id": "bEnableLockOnRolls:Combat",
          "type": "toggle",
          "text": "Directional Rolls",
          "help": "Pick the roll clip from WASD (forward / back / left / right) instead of always rolling forward.",
          "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": true }
        },
        { "type": "header", "text": "Impact — hit-stop is provided by Precision" },
        { "type": "header", "text": "Tune it in MCM → Precision → Hitstop (0.07s, 0.1x, shake)" },
        { "type": "header", "text": "ERC no longer dips TimeScale: it slows the clock, not animations" },
        { "type": "header", "text": "Hit Reactions" },
        {
          "id": "bEnableGuardBreak:Combat",
          "type": "toggle",
          "text": "Enable ERC Hit Reactions",
          "help": "ERC's own four-tier flinch/stagger/knockdown. OFF by default: Skyrim and BFCO already apply their own hit reactions, and firing a second one on the same hit stacks them into a stun-lock. The animation names on the Animations page must exist in your behaviour graph; the defaults are the vanilla events.",
          "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false }
        }
      ]
    },
    {
      "pageDisplayName": "Stagger",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "id": "fKnockdownHealthFraction:Stagger",
          "type": "slider",
          "text": "Knockdown Health Fraction",
          "help": "A power attack knocks you down only when health is below this fraction (0.35 = 35%).",
          "valueOptions": { "min": 0, "max": 1, "step": 0.05, "formatString": "{2}", "sourceType": "ModSettingFloat", "defaultValue": 0.35 }
        }
      ]
    },
    {
      "pageDisplayName": "Movement",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "id": "fRollDurationLight:Movement",
          "type": "slider",
          "text": "Light Roll Duration",
          "help": "Seconds the light-load roll takes before ERC allows another one.",
          "valueOptions": { "min": 0.2, "max": 2, "step": 0.01, "formatString": "{2} s", "sourceType": "ModSettingFloat", "defaultValue": 0.62 }
        },
        {
          "id": "fRollDurationMedium:Movement",
          "type": "slider",
          "text": "Medium Roll Duration",
          "help": "Seconds the medium-load roll takes.",
          "valueOptions": { "min": 0.2, "max": 2, "step": 0.01, "formatString": "{2} s", "sourceType": "ModSettingFloat", "defaultValue": 0.78 }
        },
        {
          "id": "fRollDurationHeavy:Movement",
          "type": "slider",
          "text": "Heavy Roll Duration",
          "help": "Seconds the heavy-load roll takes.",
          "valueOptions": { "min": 0.2, "max": 2, "step": 0.01, "formatString": "{2} s", "sourceType": "ModSettingFloat", "defaultValue": 1.05 }
        },
        {
          "id": "fEquipLoadLightCut:Movement",
          "type": "slider",
          "text": "Light Load Cutoff",
          "help": "Carried/max weight below this ratio counts as light load (ER: 0.30).",
          "valueOptions": { "min": 0, "max": 1, "step": 0.05, "formatString": "{2}", "sourceType": "ModSettingFloat", "defaultValue": 0.3 }
        },
        {
          "id": "fEquipLoadMediumCut:Movement",
          "type": "slider",
          "text": "Medium Load Cutoff",
          "help": "Carried/max weight below this ratio counts as medium load (ER: 0.70).",
          "valueOptions": { "min": 0, "max": 1, "step": 0.05, "formatString": "{2}", "sourceType": "ModSettingFloat", "defaultValue": 0.7 }
        }
      ]
    },
    {
      "pageDisplayName": "Animations",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "type": "text",
          "text": "Roll Events",
          "help": "These must be events your behaviour graph defines. The defaults are TK Dodge's own, which ship with TK Dodge SE / the OAR dodge packs in this list.",
          "valueOptions": { "value": "TK Dodge clips" }
        },
        {
          "id": "sRollEventForward:Animations",
          "type": "input",
          "text": "Roll Forward Event",
          "help": "Animation event sent for a forward roll (no movement key held).",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "TKDodgeForward" }
        },
        {
          "id": "sRollEventBack:Animations",
          "type": "input",
          "text": "Roll Back Event",
          "help": "Animation event sent when S is held.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "TKDodgeBack" }
        },
        {
          "id": "sRollEventLeft:Animations",
          "type": "input",
          "text": "Roll Left Event",
          "help": "Animation event sent when A is held.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "TKDodgeLeft" }
        },
        {
          "id": "sRollEventRight:Animations",
          "type": "input",
          "text": "Roll Right Event",
          "help": "Animation event sent when D is held.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "TKDodgeRight" }
        },
        {
          "type": "text",
          "text": "Hit Reaction Events",
          "help": "Only used when Enable ERC Hit Reactions is ON. Defaults are the vanilla stagger events.",
          "valueOptions": { "value": "vanilla stagger" }
        },
        {
          "id": "sAnimFlinch:Animations",
          "type": "input",
          "text": "Flinch Animation",
          "help": "Animation event name for the flinch reaction.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "Stagger_Small" }
        },
        {
          "id": "sAnimStagger:Animations",
          "type": "input",
          "text": "Stagger Animation",
          "help": "Animation event name for the stagger reaction.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "StaggerForward" }
        },
        {
          "id": "sAnimLargeStagger:Animations",
          "type": "input",
          "text": "Large Stagger Animation",
          "help": "Animation event name for the large stagger.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "Stagger_Large" }
        },
        {
          "id": "sAnimKnockdown:Animations",
          "type": "input",
          "text": "Knockdown Animation",
          "help": "Animation event name for the knockdown. Vanilla has no knockdown event, so this reuses the large stagger by default.",
          "valueOptions": { "sourceType": "ModSettingString", "defaultValue": "Stagger_Large" }
        }
      ]
    }
  ]
}
